pipeline
{
    agent
    {
        label 'built-in'
    }
    stages
    {
        stage('ConDownload')
        {
            steps
            {
                git 'https://github.com/IntelliqDevops/maven.git'
            }
        }
        stage('ConBuild')
        {
            steps
            {
                sh 'mvn package'
            }
        }
        stage('ConDeployment')
        {
            steps
            {
                sh 'scp /var/lib/jenkins/workspace/DeclarativePipelineOnBoth/webapp/target/webapp.war ubuntu@172.31.33.1:/var/lib/tomcat10/webapps/dpobestapp.war'
            }
        }
        stage('ConTesting')
        {
            agent 
            {
                label 'myslave'
            }
            steps
            {
                git 'https://github.com/IntelliqDevops/FunctionalTesting.git'
                sh 'java -jar /home/ubuntu/myfolder/workspace/DeclarativePipelineOnBoth/testing.jar'
            }
        }
        stage('ConDelivery')
        {
            steps
            {
                sh 'scp /var/lib/jenkins/workspace/DeclarativePipelineOnBoth/webapp/target/webapp.war ubuntu@172.31.40.4:/var/lib/tomcat10/webapps/dpobprodapp.war'
            }
        }
    }
}
