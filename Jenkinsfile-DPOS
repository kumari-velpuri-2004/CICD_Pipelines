        {
            steps
            {
                git 'https://github.com/IntelliqDevops/maven.git'
            }
        }
        stage('ConBuild')
        {
            steps
            {
                sh 'mvn package'
            }
        }
        stage('ConDeployment')
        {
            steps
            {
                sh 'scp /home/ubuntu/myfolder/workspace/DeclarativePipelineonSlave/webapp/target/webapp.war ubuntu@172.31.33.1:/var/lib/tomcat10/webapps/dpostestapp.war'
            }
        }
        stage('ConTesting')
