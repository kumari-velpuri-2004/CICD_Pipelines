        }
        stage('ConDelivery')
        {
            steps
            {
                sh 'scp /home/ubuntu/myfolder/workspace/DeclarativePipelineonSlave/webapp/target/webapp.war ubuntu@172.31.40.4:/var/lib/tomcat10/webapps/dposprodapp.war'
            }
